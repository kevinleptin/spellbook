<Application x:Class="Spellbook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 启动逻辑在 App.xaml.cs 中手动装配(无 StartupUri) -->
    <Application.Resources>

        <!-- ======== 配色令牌(魔兽世界主题):所有控件仅引用令牌,不写死颜色 ======== -->
        <Color x:Key="BackgroundColor">#0E0B08</Color>       <!-- 近黑暖褐 -->
        <Color x:Key="PanelColor">#1A140C</Color>            <!-- 面板底 -->
        <Color x:Key="GoldLightColor">#F0C860</Color>        <!-- 金框亮部 -->
        <Color x:Key="GoldColor">#C9A44A</Color>             <!-- 金框主色 -->
        <Color x:Key="GoldDarkColor">#6B4413</Color>         <!-- 金框暗部 -->
        <Color x:Key="TextColor">#E8D8B0</Color>             <!-- 羊皮纸正文 -->
        <Color x:Key="TextDimColor">#8A7A5A</Color>          <!-- 次要字 -->
        <Color x:Key="EpicColor">#A335EE</Color>             <!-- 史诗紫 -->
        <Color x:Key="RareColor">#0070DD</Color>             <!-- 稀有蓝 -->
        <Color x:Key="UncommonColor">#1EFF00</Color>         <!-- 优秀绿 -->
        <Color x:Key="LegendaryColor">#FF8000</Color>        <!-- 传说橙 -->
        <Color x:Key="SystemYellowColor">#FFC125</Color>     <!-- 系统黄(状态栏前缀) -->
        <Color x:Key="ErrorRedColor">#FF4040</Color>         <!-- 错误红 -->
        <Color x:Key="TooltipBackgroundColor">#0A0A1E</Color><!-- 提示框深蓝黑底 -->
        <!-- 红按钮与磁贴底色的派生色(同属令牌,便于统一调整) -->
        <Color x:Key="RedButtonLightColor">#A32424</Color>
        <Color x:Key="RedButtonColor">#8B1A1A</Color>
        <Color x:Key="RedButtonDarkColor">#6E1111</Color>
        <Color x:Key="RedButtonHoverLightColor">#C03030</Color>
        <Color x:Key="RedButtonHoverDarkColor">#801717</Color>
        <Color x:Key="TileCenterColor">#3A2E1C</Color>       <!-- 图标底径向渐变中心(微亮) -->
        <Color x:Key="TileEdgeColor">#14100A</Color>         <!-- 图标底径向渐变边缘 -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="EpicBrush" Color="{StaticResource EpicColor}"/>
        <SolidColorBrush x:Key="RareBrush" Color="{StaticResource RareColor}"/>
        <SolidColorBrush x:Key="UncommonBrush" Color="{StaticResource UncommonColor}"/>
        <SolidColorBrush x:Key="LegendaryBrush" Color="{StaticResource LegendaryColor}"/>
        <SolidColorBrush x:Key="SystemYellowBrush" Color="{StaticResource SystemYellowColor}"/>
        <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}"/>
        <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{StaticResource TooltipBackgroundColor}" Opacity="0.95"/>

        <!-- 红按钮渐变(默认 / 悬停提亮) -->
        <LinearGradientBrush x:Key="RedButtonBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource RedButtonLightColor}" Offset="0"/>
            <GradientStop Color="{StaticResource RedButtonColor}" Offset="0.5"/>
            <GradientStop Color="{StaticResource RedButtonDarkColor}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource RedButtonHoverLightColor}" Offset="0"/>
            <GradientStop Color="{StaticResource RedButtonColor}" Offset="0.5"/>
            <GradientStop Color="{StaticResource RedButtonHoverDarkColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- 磁贴图标底:深色径向渐变,中心微亮 -->
        <RadialGradientBrush x:Key="TileIconBackground">
            <GradientStop Color="{StaticResource TileCenterColor}" Offset="0"/>
            <GradientStop Color="{StaticResource TileEdgeColor}" Offset="1"/>
        </RadialGradientBrush>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ======== 游戏物品提示框样式 ======== -->
        <Style x:Key="GameToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource TooltipBackgroundBrush}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== 游戏红按钮("＋ 新建")======== -->
        <Style x:Key="RedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{StaticResource RedButtonBackground}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource RedButtonHoverBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== 深色输入框(搜索框 / 对话框)======== -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
