<Window x:Class="Spellbook.Views.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Spellbook.Views"
        xmlns:services="clr-namespace:Spellbook.Services"
        Title="添加脚本"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <views:IconKeyToImageConverter x:Key="IconKeyToImage"/>
        <!-- 表单标签统一样式 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- 深色可编辑下拉框(分组选择) -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource GoldDarkBrush}"
                                    BorderThickness="1"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     Padding="6,4"
                                     Margin="0,0,20,0"
                                     VerticalContentAlignment="Center"/>
                            <ToggleButton HorizontalAlignment="Right" Width="20"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource GoldBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Placement="Bottom"
                                   StaysOpen="False">
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource GoldDarkBrush}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 脚本文件 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="脚本文件" Style="{StaticResource LabelStyle}"/>
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="浏览…" Click="Browse_Click"
                    Style="{StaticResource RedButtonStyle}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}"/>
        </DockPanel>

        <!-- 名称 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="名称" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBoxStyle}"/>

        <!-- 参数 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="参数" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBoxStyle}"/>

        <!-- 备注(多行) -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="备注" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,4,10,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="72"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBoxStyle}"/>

        <!-- 分组 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="分组" Style="{StaticResource LabelStyle}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,16"
                  Style="{StaticResource DarkComboBoxStyle}"
                  ItemsSource="{Binding ExistingGroups}"
                  Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- 图标(仿魔兽宏命令的图标网格,任选其一) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="图标" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,6,10,0"/>
        <ListBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,16" Height="150"
                 Background="{StaticResource PanelBrush}"
                 BorderBrush="{StaticResource GoldDarkBrush}"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{x:Static services:IconLibrary.All}"
                 SelectedValuePath="Key"
                 SelectedValue="{Binding IconKey}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- 选中项金色高亮边框 -->
                                <Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent"
                                        CornerRadius="4" Padding="2" Margin="1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldLightBrush}"/>
                                        <Setter TargetName="Frame" Property="Background" Value="{StaticResource GoldDarkBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{StaticResource GoldDarkBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Width="24" Height="24"
                           Source="{Binding Key, Converter={StaticResource IconKeyToImage}}"
                           ToolTip="{Binding DisplayName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 按钮行 -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource RedButtonStyle}"
                    IsEnabled="{Binding CanConfirm}" IsDefault="True"
                    MinWidth="72" Click="Ok_Click"/>
            <Button Content="取消" Style="{StaticResource RedButtonStyle}"
                    IsCancel="True" MinWidth="72" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
