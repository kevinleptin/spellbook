<Window x:Class="Spellbook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Spellbook.ViewModels"
        Title="Spellbook"
        Width="560" Height="640"
        MinWidth="360" MinHeight="300"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>

        <!-- ======== 磁贴 = 技能按钮 ======== -->
        <Style x:Key="SpellTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="66" Margin="2">
                            <!-- 图标块:三层金属浮雕描边(外亮/中主/内暗)+ 深色径向渐变底 -->
                            <Grid x:Name="IconBlock" Width="46" Height="46" HorizontalAlignment="Center">
                                <Border BorderBrush="{StaticResource GoldLightBrush}" BorderThickness="1" CornerRadius="7">
                                    <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" CornerRadius="6">
                                        <Border BorderBrush="{StaticResource GoldDarkBrush}" BorderThickness="1" CornerRadius="5"
                                                Background="{StaticResource TileIconBackground}">
                                            <Grid>
                                                <!-- 内置默认图标:一本摊开的法术书 -->
                                                <Path Data="M4,6 C8,3 14,3 18,6 C22,3 28,3 32,6 L32,26 C28,23 22,23 18,26 C14,23 8,23 4,26 Z M18,6 L18,26"
                                                      Stroke="{StaticResource GoldBrush}"
                                                      StrokeThickness="1.6"
                                                      Fill="Transparent"
                                                      Stretch="Uniform" Margin="8"/>
                                                <!-- 路径失效警告标记 -->
                                                <TextBlock Text="⚠"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SystemYellowBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           Margin="0,-1,1,0"
                                                           Visibility="{Binding PathMissing, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </Grid>
                            <!-- 标题(超 4 字符截断加 …) -->
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- 悬停:淡金色外发光,模拟技能可施放 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBlock" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource GoldLightColor}"
                                                          BlurRadius="12" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- 按下:图标下沉 1px 并变暗 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBlock" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="IconBlock" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== 磁贴数据模板 ======== -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Button Style="{StaticResource SpellTileStyle}"
                    Click="Tile_Click"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove"
                    DragOver="Tile_DragOver"
                    Drop="Tile_Drop"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Button.ToolTip>
                    <!-- 仿游戏物品提示框 -->
                    <ToolTip Style="{StaticResource GameToolTipStyle}">
                        <StackPanel MaxWidth="320">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource GoldLightBrush}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding TooltipPathLine}"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding Notes}"
                                       Foreground="{StaticResource UncommonBrush}"
                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑" Click="Edit_Click"/>
                        <MenuItem Header="删除" Click="Delete_Click"/>
                        <MenuItem Header="移动" SubmenuOpened="Move_SubmenuOpened">
                            <!-- 占位项使子菜单箭头显示,打开时动态替换为分组列表 -->
                            <MenuItem Header="(无分组)"/>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <!-- ======== 分组数据模板(标题仿任务日志)======== -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:GroupViewModel}">
            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="10,12,10,2">
                    <Grid.Resources>
                        <!-- 4×4 旋转 45° 的菱形装饰 -->
                        <Style x:Key="Diamond" TargetType="Rectangle">
                            <Setter Property="Width" Value="4"/>
                            <Setter Property="Height" Value="4"/>
                            <Setter Property="Fill" Value="{StaticResource GoldBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="45"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="GoldLine" TargetType="Rectangle">
                            <Setter Property="Height" Value="1"/>
                            <Setter Property="Fill" Value="{StaticResource GoldDarkBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Style="{StaticResource Diamond}"/>
                    <Rectangle Grid.Column="1" Style="{StaticResource GoldLine}"/>
                    <Rectangle Grid.Column="2" Style="{StaticResource Diamond}"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" Margin="10,0"/>
                    <Rectangle Grid.Column="4" Style="{StaticResource Diamond}"/>
                    <Rectangle Grid.Column="5" Style="{StaticResource GoldLine}"/>
                    <Rectangle Grid.Column="6" Style="{StaticResource Diamond}"/>
                </Grid>
                <!-- 组容器接受拖放(拖到组内空白 = 移到组尾);Background 透明用于命中测试 -->
                <Border Background="Transparent" AllowDrop="True"
                        DragOver="Group_DragOver" Drop="Group_Drop"
                        Padding="6,2,6,6" MinHeight="40">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 状态栏文字样式(退出码非 0 时整行红色) -->
        <Style x:Key="StatusPrefixStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SystemYellowBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- 顶部:搜索框 + 新建按钮 -->
        <Grid DockPanel.Dock="Top" Margin="10,10,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- 占位提示,仅在搜索框为空时显示 -->
                <TextBlock Text="搜索 (Ctrl+K)"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="＋ 新建"
                    Style="{StaticResource RedButtonStyle}"
                    Click="New_Click"/>
        </Grid>

        <!-- 底部:状态栏(仿聊天框,等宽字体) -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GoldDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="[Spellbook] " FontFamily="Consolas" Style="{StaticResource StatusPrefixStyle}"/>
                <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" Style="{StaticResource StatusTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- 中部:分组磁贴网格 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" Margin="4"/>
        </ScrollViewer>

    </DockPanel>
</Window>
